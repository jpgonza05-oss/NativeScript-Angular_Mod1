{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "dom"
    ],
    "emitDecoratorMetadata": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ]
    }
  },
  "files": [
    "./src/main.ts",
    "./src/polyfills.ts"
  ],
  "include": [
    "references.d.ts",
    "src/**/*.d.ts"
  ]
}
